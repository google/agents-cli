{
  "name": "agents-cli-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "cd .. && uv run python docs/scripts/gen_reference.py",
    "convert": "node scripts/convert-docs.mjs",
    "dev": "npm run gen && npm run convert && astro dev",
    "build": "npm run gen && npm run convert && astro build && pagefind --site ../site",
    "preview": "astro preview",
    "check-links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.4.3",
    "astro": "^7.3.5",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "js-yaml": "^5.4.2",
    "pagefind": "^1.5.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
