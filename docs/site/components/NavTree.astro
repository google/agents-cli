import { withBase, type NavItem } from '../lib/docs';
import NavTree from './NavTree.astro';
interface Props { items: NavItem[]; current: string; depth?: number }
const { items, current, depth = 0 } = Astro.props;
const contains = (n: NavItem): boolean => n.url === current || !!n.children?.some(contains);
const href = (n: NavItem) => (n.url ? withBase(n.url) : undefined);
---
<ul class={`nav-tree d${depth}`}>
  {items.map((n) => n.children?.length ? (
    <li>
      <details open={depth === 1 || contains(n)}>
        <summary class={n.url === current ? 'on' : ''}>
          {n.url && depth > 0 ? <a href={href(n)} aria-current={n.url === current ? 'page' : undefined}>{n.title}</a> : <span>{n.title}</span>}
        </summary>
        {depth === 0 && n.url ? <ul class="nav-tree d1"><li><a href={href(n)} class={n.url === current ? 'on' : ''} aria-current={n.url === current ? 'page' : undefined}>Overview</a></li></ul> : null}
        <NavTree items={n.children} current={current} depth={depth + 1} />
      </details>
    </li>
  ) : (
    <li><a href={href(n)} class={n.url === current ? 'on' : ''} aria-current={n.url === current ? 'page' : undefined}>{n.title}{n.external ? ' ↗' : ''}</a></li>
  ))}
</ul>
