import Base from '../layouts/Base.astro';
import HomeStart from '../components/HomeStart.astro';
import HomeJourney from '../components/HomeJourney.astro';
import HomeRules from '../components/HomeRules.astro';
import HomeFrameworks from '../components/HomeFrameworks.astro';
import HomeTiles from '../components/HomeTiles.astro';
import { withBase } from '../lib/docs';
import { rulesUses, docsLinks } from '../data/home';
import '../styles/home.css';
import '../styles/home-session.css';
import '../styles/home-sections.css';

const description = 'The CLI and skills that walk your coding agent through building, evaluating, and deploying AI agents on Google Cloud.';
---
<Base title="Agents CLI: build AI agents on Google Cloud that meet your production standards" description={description} bodyClass="home">
  <!-- hero: the promise centered between the Agents CLI and Google Cloud marks, then the start box -->
  <section class="hero" data-hero>
    <div class="wrap hero-center">
      <HomeTiles />
      <h1 class="display hero-h1"><span>Build AI agents</span> <span>that meet your</span> <em class="hl">production&nbsp;standards.</em></h1>
      <p class="lede">Agents&nbsp;CLI teaches your coding agent how to ship them on Google&nbsp;Cloud.</p>
      <HomeStart uid="hero" />
    </div>
  </section>

  <!-- session: the whole lifecycle as a coding agent's session per stage, the loop back to evals drawn in the stepper -->
  <a id="lifecycle" class="sec-anchor" aria-hidden="true" tabindex="-1"></a>
  <section class="sec" id="session">
    <div class="wrap">
      <HomeJourney>
        <h2 class="h2">The whole lifecycle, one CLI</h2>
        <p class="sub">Your coding agent builds until evals pass, ships to Google Cloud, and learns from&nbsp;production.</p>
      </HomeJourney>
    </div>
  </section>

  <!-- extensions: heading, one line and two uses left; right, every deploy passes the acme-policy checkpoint -->
  <section class="sec" id="rules">
    <div class="wrap split">
      <div class="split-l rl-side">
        <h2 class="h2">Your rules, as extensions</h2>
        <p class="sub">An extension adds your checks and skills to agents-cli. Everyone keeps running the same <code>agents-cli deploy</code>.</p>
        <ul class="rl-uses">
          {rulesUses.map(([t, d]) => <li><b>{t}.</b> {d}</li>)}
        </ul>
        <a class="more" href={withBase('/guide/extensions/using/')}>How extensions work</a>
      </div>
      <HomeRules />
    </div>
  </section>

  <!-- frameworks: heading and one line; under them, full width, four framework cards over one Agents CLI slab -->
  <section class="sec" id="frameworks">
    <div class="wrap">
      <div class="fw-side">
        <h2 class="h2">Build agents with any framework</h2>
        <p class="sub">Pick your framework. The commands stay the same.</p>
      </div>
      <HomeFrameworks />
    </div>
  </section>

  <!-- the way out: the main entry points into the docs -->
  <section class="sec" id="docs">
    <div class="wrap">
      <h2 class="h2">Explore the docs</h2>
      <ul class="fw-cards docs-cards">
        {docsLinks.map((d) => (
          <li class="fw-c">
            <h3 class="fw-n"><a href={withBase(d.href)}>{d.name}</a></h3>
            <p class="fw-d">{d.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Base>
