# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT={{cookiecutter.google_cloud_project}}
GOOGLE_CLOUD_LOCATION=global
# Region for Claude calls: "global" or a region such as "us-east5".
CLOUD_ML_REGION=global
{%- if cookiecutter.bq_analytics %}

# Uncomment to log local runs too.
# BQ_ANALYTICS_DATASET_ID={{cookiecutter.project_name | replace('-', '_')}}_telemetry
{%- endif %}
{%- if cookiecutter.memory_bank %}

# Long-term memory of each user, in Memory Bank.
MEMORY_BANK_ENABLED=true
{%- endif %}
