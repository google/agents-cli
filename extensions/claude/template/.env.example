# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Region for Claude calls: "global" or a region such as "us-east5".
CLOUD_ML_REGION=global

# Uncomment to log local runs too.
# BQ_ANALYTICS_DATASET_ID=your_dataset

# Long-term memory of each user, in Memory Bank (scaffold with --memory-bank).
# MEMORY_BANK_ENABLED=true
# Off Agent Runtime: the display name of the Agent Runtime engine that holds the
# memories, created when missing. Defaults to the agent's name.
# MEMORY_BANK_ENGINE_NAME=your-agent
